# Usamos la imagen oficial de Jenkins como base
FROM jenkins/jenkins:lts

# Cambiamos a root para instalar paquetes
USER root

# Instalamos Docker CLI y Docker Compose
RUN apt-get update && \
    apt-get install -y docker.io docker-compose && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Volvemos al usuario original de Jenkins
USER jenkins